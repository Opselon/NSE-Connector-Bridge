# -*- mode: python ; coding: utf-8 -*-
# PyInstaller spec: NSE MT5 Bridge executable (v1.3.0: cross-platform).
#
# One spec builds every release target — PyInstaller cannot
# cross-compile, so each OS/arch builds natively on its own CI runner
# (.github/workflows/build.yml: build-windows, build-windows-arm,
# build-unix):
#   Windows x64    single-file exe + Inno Setup installer
#   Windows ARM64  single-file exe, core-only (no MetaTrader5 wheel)
#   macOS x64/arm64  .app bundle (BUNDLE below) -> .dmg
#   Linux x64/arm64  single-file binary -> tarball
#
# Windows-only pieces are gated on sys.platform == "win32" and must
# never break a macOS/Linux build: the MetaTrader5 package (win_amd64
# wheels only — absent on macOS/Linux and on native-ARM64 Windows),
# the VSVersionInfo resource + app manifest, and the .ico icon
# (macOS has no .icns asset yet; the .app ships without a custom
# icon until one is generated — see docs/BUILD.md §3).

import re
import sys
from pathlib import Path

from PyInstaller.utils.hooks import collect_all, collect_submodules

IS_WINDOWS = sys.platform == "win32"
IS_MAC = sys.platform == "darwin"


def _bridge_version() -> str:
    """BRIDGE_VERSION without importing the package (spec-time parse).

    SPECPATH is the PyInstaller spec global for the spec file's
    directory (PyInstaller 6 removed SPEC_DIR; __file__ is not set
    in the spec namespace either — both raised NameError on macOS).
    """
    text = (Path(SPECPATH) / "nse_bridge" / "__init__.py").read_text(encoding="utf-8")
    match = re.search(r'^BRIDGE_VERSION\s*=\s*"([^"]+)"', text, re.M)
    return match.group(1) if match else "0.0.0"


datas, binaries, hiddenimports = [], [], []

# MetaTrader5 is Windows-only AND x64-only: on macOS/Linux (and on a
# native-ARM64 Windows Python) the package is not installed, so
# collect_all would raise — skip it there. The bridge core runs
# without it; terminal attach reports MT5_WINDOWS_REQUIRED instead
# (nse_bridge.mt5.driver.MT5_PLATFORM_SUPPORTED).
for pkg in ("numpy", "pywebview", "websockets", "uvicorn", "loguru"):
    d, b, h = collect_all(pkg)
    datas += d
    binaries += b
    hiddenimports += h
if IS_WINDOWS:
    try:
        d, b, h = collect_all("MetaTrader5")
        datas += d
        binaries += b
        hiddenimports += h
    except Exception:  # noqa: BLE001 — native ARM64 Windows has no wheel
        pass

hiddenimports += [
    "uvicorn.logging",
    "uvicorn.loops",
    "uvicorn.loops.auto",
    "uvicorn.protocols",
    "uvicorn.protocols.http",
    "uvicorn.protocols.http.auto",
    "uvicorn.protocols.websockets",
    "uvicorn.protocols.websockets.auto",
    "uvicorn.lifespan",
    "uvicorn.lifespan.on",
    "anyio._backends._asyncio",
]
try:
    hiddenimports += collect_submodules("webview.platforms")
except Exception:  # noqa: BLE001 — a backend missing on this host is not fatal
    pass

datas += [("nse_bridge/gui/static", "nse_bridge/gui/static")]
# The application icon as a runtime data file (in addition to the
# exe resource below): the splash window and the pywebview window
# load it at runtime via nse_bridge.gui.icon.app_icon_path()
# (LoadImageW / webview.start(icon=...)). Without this the frozen
# exe has no .ico file to load — only the exe resource remains.
datas += [("assets/icon.ico", "assets")]
# The release-signing PUBLIC key (P1-6): the frozen exe verifies
# update signatures against it via load_update_public_key(), which
# reads nse_bridge/update_public_key.b64 next to updates.py — under
# PyInstaller that is _MEIPASS/nse_bridge/, so the file must be
# bundled as data or the updater fail-closes with NO_PUBLIC_KEY.
# Public material only; the private key never enters this repo.
datas += [("nse_bridge/update_public_key.b64", "nse_bridge")]

a = Analysis(
    ["run_bridge.py"],
    pathex=["."],
    binaries=binaries,
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    runtime_hooks=[],
    excludes=["tkinter", "matplotlib", "pandas", "pytest"],
    noarchive=False,
)
pyz = PYZ(a.pure)

# Windows-only EXE metadata: version resource + manifest + icon are
# meaningless (and, for version/manifest, rejected) off Windows.
exe_kwargs: dict = {}
if IS_WINDOWS:
    exe_kwargs["version"] = "version_info.txt"
    exe_kwargs["manifest"] = "windows/NSE-MT5-Bridge.exe.manifest"
    # Original NSE-branded icon, generated by scripts/make_icon.py
    # (pure numpy distance-field render → PNG-compressed .ico; see
    # tests/unit/test_icon_asset.py for the integrity gate).
    exe_kwargs["icon"] = "assets/icon.ico"

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    name="NSE-MT5-Bridge",
    # Phase 6: windowed exe — no console window in production.
    # Diagnostics use `NSE-MT5-Bridge.exe --diagnostic`, which enables
    # DEBUG telemetry/logging and (frozen Windows) allocates a console.
    console=False,
    disable_windowed_traceback=False,
    upx=False,
    # Version metadata + Windows manifest, generated from
    # nse_bridge.BRIDGE_VERSION by scripts/write_version_info.py
    # (run it after every version bump; CI --check enforces freshness).
    **exe_kwargs,
)

if IS_MAC:
    # macOS .app bundle around the onefile exe (CI packs it into a
    # .dmg with hdiutil). Unsigned — Gatekeeper asks on first open;
    # see docs/INSTALLATION.md. No .icns asset exists yet.
    app = BUNDLE(
        exe,
        name="NSE-MT5-Bridge.app",
        icon=None,
        bundle_identifier="space.nexusverse.nse-bridge",
        info_plist={
            "CFBundleShortVersionString": _bridge_version(),
            "CFBundleVersion": _bridge_version(),
            "CFBundleName": "NSE MT5 Bridge",
            "NSHighResolutionCapable": "True",
        },
    )
